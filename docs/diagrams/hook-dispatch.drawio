<mxfile host="drawio"><diagram id="page-1" name="Page-1"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="call" value="&lt;b&gt;The model makes a tool call&lt;/b&gt;&lt;br&gt;Bash, Edit, Write, or an MCP tool" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="300" height="60" as="geometry"/></mxCell><mxCell id="claude" value="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;enforces the deny list natively, then runs the registry hooks itself" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="320" height="80" as="geometry"/></mxCell><mxCell id="codex" value="&lt;b&gt;Codex&lt;/b&gt;&lt;br&gt;~/.codex/hooks.json sends each event to hooks/lib/dispatch.sh" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="370" y="140" width="320" height="80" as="geometry"/></mxCell><mxCell id="pi" value="&lt;b&gt;Pi&lt;/b&gt;&lt;br&gt;pi-permission-system applies the derived deny policy; hook-bridge.ts calls dispatch.sh" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="320" height="80" as="geometry"/></mxCell><mxCell id="registry" value="&lt;b&gt;settings.json hook registry&lt;/b&gt;&lt;br&gt;event, matcher, and if pattern pick the scripts, run in registry order" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="290" width="500" height="70" as="geometry"/></mxCell><mxCell id="hooks" value="&lt;b&gt;hooks/*.sh&lt;/b&gt;&lt;br&gt;deny gate, commit gates, push gate, PR gates, test lock, prose gate, post-edit lint" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="280" y="420" width="500" height="70" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;exit 0&lt;/b&gt;: the tool call runs&lt;br&gt;JSON additionalContext reaches the model" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="560" width="340" height="70" as="geometry"/></mxCell><mxCell id="block" value="&lt;b&gt;exit 2&lt;/b&gt;: the tool call is blocked&lt;br&gt;stderr goes back to the model as feedback" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="560" width="340" height="70" as="geometry"/></mxCell><mxCell id="c0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="call" target="claude"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="call" target="codex"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="call" target="pi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="claude" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="codex" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pi" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="registry" target="hooks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hooks" target="ok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hooks" target="block"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
