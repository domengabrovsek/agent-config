<mxfile host="drawio"><diagram id="page-1" name="Page-1"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane" value="Lane mode: writers change files (star)" style="swimlane;startSize=32;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="460" height="370" as="geometry"/></mxCell><mxCell id="lp" value="Parent session" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="lane"><mxGeometry x="160" y="50" width="140" height="46" as="geometry"/></mxCell><mxCell id="lt0" value="Teammate A&lt;br&gt;own worktree,&lt;br&gt;own files" style="rounded=1;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="lane"><mxGeometry x="20" y="220" width="120" height="70" as="geometry"/></mxCell><mxCell id="le0" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lt0" target="lp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lt1" value="Teammate B&lt;br&gt;own worktree,&lt;br&gt;own files" style="rounded=1;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="lane"><mxGeometry x="170" y="220" width="120" height="70" as="geometry"/></mxCell><mxCell id="le1" value="report" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lt1" target="lp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lt2" value="Teammate C&lt;br&gt;own worktree,&lt;br&gt;own files" style="rounded=1;fillColor=#ffffff;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1"