ht="56" as="geometry"/></mxCell><mxCell id="pm0" value="SendMessage" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="pt0" target="pt1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pm1" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="pt0" target="pt2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pm2" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="pt1" target="pt2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pr" value="one answer" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pt2" target="pp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pnote" value="Teammates challenge each other, then the parent gets one combined answer." style="text;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="panel"><mxGeometry x="30" y="310" width="400" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
