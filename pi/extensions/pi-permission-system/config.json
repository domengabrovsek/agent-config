      "git push * main": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push origin main *": "deny",
      "git reset --hard *": "deny",
      "mkfs *": "deny",
      "rm -rf *": "deny",
      "shred *": "deny",
      "sudo *": "deny"
